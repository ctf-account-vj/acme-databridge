# Copy this file to .env and fill in values for local development.
# NEVER commit .env — it is gitignored.

# PostgreSQL connection (individual vars — used by db_config.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acmedb
DB_USER=acme_admin
DB_PASSWORD=changeme
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Acme CRM API
ACME_API_BASE_URL=https://api.acme-internal.net
ACME_API_TOKEN=your-api-token-here

# Sync behaviour (optional)
SYNC_BATCH_SIZE=500
SYNC_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
